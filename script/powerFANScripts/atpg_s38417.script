read_lib techlib/mod_nangate45.mdt
read_netlist mod_netlist/s38417.v
report_netlist
set_pattern_type LOC
build_circuit --frame 2
report_circuit
set_fault_type tdf
add_fault --all
set_static_compression on
set_dynamic_compression on
set_X-Fill power
run_atpg
report_statistics > power_rpt/FAN_power_s38417.rpt
write_pattern power_pat/FAN_power_s38417.pat
write_to_STIL power_pat/FAN_power_s38417.stil
exit
