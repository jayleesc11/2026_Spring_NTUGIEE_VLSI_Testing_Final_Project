read_lib techlib/mod_nangate45.mdt
read_netlist mod_netlist/s208.v
report_netlist
build_circuit --frame 1
report_circuit
set_fault_type saf
add_fault --all
set_static_compression on
set_dynamic_compression on
set_X-Fill power
run_atpg
report_statistics > power_rpt/FAN_power_s208.rpt
write_pattern power_pat/FAN_power_s208.pat
write_to_STIL power_pat/FAN_power_s208.stil
exit
