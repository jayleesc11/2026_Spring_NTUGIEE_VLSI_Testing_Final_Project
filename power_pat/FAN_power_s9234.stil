   PatternBurst "_burst_";
}

Procedures {
   "load_unload" {
       W "_default_WFT_";
       C { "test_si"=0; "CK"=0; "test_se"=1; }
       V { "_so"=#; }
       Shift {
           W "_default_WFT_";
           V { "_si"=#; "_so"=#; "CK"=P; }
       }
   }
   "capture_CK" {
       W "_default_WFT_";
       F { "test_se"=0; }
       C { "_po"=\r40 X ; }
       "forcePI": V { "_pi"=\r39 # ; }
       "measurePO": V { "_po"=\r40 # ; }
       C { "_po"=\r40 X ; }
       "pulse": V { "CK"=P; }
   }
   "capture" {
       W "_default_WFT_";
       F { "test_se"=0; }
       C { "_po"=\r40 X ; }
       "forcePI": V { "_pi"=\r39 # ; }
       "measurePO": V { "_po"=\r40 # ; }
   }
}

