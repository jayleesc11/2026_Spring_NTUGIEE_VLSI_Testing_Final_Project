STIL 1.0;

Signals {
   "CK" In;
   "test_si" In { ScanIn; }
   "test_se" In;
   "G0" In;
   "G1" In;
   "G2" In;
   "G3" In;
   "test_so" Out { ScanOut; }
   "G17" Out;
}

SignalGroups {
   "_pi" = '"CK" + "test_si" + "test_se" + "G0" + "G1" + "G2" + "G3"';
   "_in" = '"CK" + "test_si" + "test_se" + "G0" + "G1" + "G2" + "G3"';
   "_si" = '"test_si"' { ScanIn; }
   "_po" = '"test_so" + "G17"';
   "_out" = '"test_so" + "G17"';
   "_so" = '"test_so"' { ScanOut; }
   "_default_In_Timing_" = '"test_si" + "test_se" + "G0" + "G1" + "G2" + "G3"';
   "_default_Out_Timing_" = '"test_so" + "G17"';
}

Timing {
   WaveformTable "_default_WFT_" {
       Period '100ns';
       Waveforms {
           "CK" { 0 { '0ns' D; } }
           "CK" { P { '0ns' D; '50ns' U; '75ns' D; } }
           "CK" { 1 { '0ns' U; } }
           "CK" { Z { '0ns' Z; } }
           "_default_In_Timing_" { 0 { '0ns' D; } }
           "_default_In_Timing_" { 1 { '0ns' U; } }
           "_default_In_Timing_" { Z { '0ns' Z; } }
           "_default_In_Timing_" { N { '0ns' N; } }
           "_default_Out_Timing_" { X { '0ns' X; } }
           "_default_Out_Timing_" { H { '0ns' X; ' 90 ns' H; } }
           "_default_Out_Timing_" { T { '0ns' X; ' 90 ns' T; } }
           "_default_Out_Timing_" { L { '0ns' X; ' 90 ns' L; } }
       }
   }
}

ScanStructures {
   ScanChain "chain1" {
       ScanLength 3;
       ScanIn "test_si";
       ScanOut "test_so";
       ScanInversion 0;
       ScanCells "TOP.U_G5.SI" "TOP.U_G6.SI" "TOP.U_G7.SI";
       ScanMasterClock "CK" ;
   }
}

PatternBurst "_burst_" {
   PatList { "_pattern_" { } }
}

PatternExec {
   PatternBurst "_burst_";
}

Procedures {
   "load_unload" {
       W "_default_WFT_";
       C { "test_si"=0; "CK"=0; "test_se"=1; }
       V { "_so"=#; }
       Shift {
           W "_default_WFT_";
           V { "_si"=#; "_so"=#; "CK"=P; }
       }
   }
   "capture_CK" {
       W "_default_WFT_";
       F { "test_se"=0; }
       C { "_po"=\r2 X ; }
       "forcePI": V { "_pi"=\r7 # ; }
       "measurePO": V { "_po"=\r2 # ; }
       C { "_po"=\r2 X ; }
       "pulse": V { "CK"=P; }
   }
   "capture" {
       W "_default_WFT_";
       F { "test_se"=0; }
       C { "_po"=\r2 X ; }
       "forcePI": V { "_pi"=\r7 # ; }
       "measurePO": V { "_po"=\r2 # ; }
   }
}

MacroDefs {
   "test_setup" {
       W "_default_WFT_";
       V { "test_se"=0; "CK"=0; }
   }
}

Pattern "_pattern_" {
   W "_default_WFT_";
   "precondition all Signals": C { "_pi"=\r7 0 ; "_po"=\r2 X ; }
   Macro "test_setup";
   "pattern 0":
       Call "load_unload" {
           "test_si"=NN1;
       }
       Call "capture_CK" {
           "_pi"=0000N1N;
           "_po"=LH;
       }
       Call "capture_CK" {
           "_pi"=00010N1;
           "_po"=LL;
       }
   "pattern 1":
       Call "load_unload" {
           "test_so"=LHL;
           "test_si"=N1N;
       }
       Call "capture_CK" {
           "_pi"=0000N1N;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=00010N0;
           "_po"=LH;
       }
   "pattern 2":
       Call "load_unload" {
           "test_so"=LLH;
           "test_si"=0N0;
       }
       Call "capture_CK" {
           "_pi"=00010N1;
           "_po"=LL;
       }
       Call "capture_CK" {
           "_pi"=0000NN0;
           "_po"=LL;
       }
   "pattern 3":
       Call "load_unload" {
           "test_so"=NHL;
           "test_si"=N0N;
       }
       Call "capture_CK" {
           "_pi"=0000N10;
           "_po"=LH;
       }
       Call "capture_CK" {
           "_pi"=000N0N1;
           "_po"=LL;
       }
   "pattern 4":
       Call "load_unload" {
           "test_so"=LHL;
           "test_si"=N0N;
       }
       Call "capture_CK" {
           "_pi"=000011N;
           "_po"=LH;
       }
       Call "capture_CK" {
           "_pi"=000N0N1;
           "_po"=LL;
       }
   "pattern 5":
       Call "load_unload" {
           "test_so"=LHL;
           "test_si"=NNN;
       }
       Call "capture_CK" {
           "_pi"=000N10N;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=000NN1N;
           "_po"=LN;
       }
   "pattern 6":
       Call "load_unload" {
           "test_so"=LNN;
           "test_si"=0N0;
       }
       Call "capture_CK" {
           "_pi"=00000N1;
           "_po"=LL;
       }
       Call "capture_CK" {
           "_pi"=00011N1;
           "_po"=LH;
       }
   "pattern 7":
       Call "load_unload" {
           "test_so"=NLH;
           "test_si"=N1N;
       }
       Call "capture_CK" {
           "_pi"=0000NNN;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=00011N1;
           "_po"=LH;
       }
   "pattern 8":
       Call "load_unload" {
           "test_so"=NLH;
           "test_si"=0N0;
       }
       Call "capture_CK" {
           "_pi"=00010N1;
           "_po"=LL;
       }
       Call "capture_CK" {
           "_pi"=00001N1;
           "_po"=LL;
       }
   "pattern 9":
       Call "load_unload" {
           "test_so"=NHL;
           "test_si"=0NN;
       }
       Call "capture_CK" {
           "_pi"=000N0NN;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=000N10N;
           "_po"=LN;
       }
   "pattern 10":
       Call "load_unload" {
           "test_so"=HNN;
           "test_si"=NNN;
       }
       Call "capture_CK" {
           "_pi"=0000N11;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=00010N0;
           "_po"=LH;
       }
   "pattern 11":
       Call "load_unload" {
           "test_so"=LLH;
           "test_si"=NNN;
       }
       Call "capture_CK" {
           "_pi"=000N11N;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=000N00N;
           "_po"=LN;
       }
   "pattern 12":
       Call "load_unload" {
           "test_so"=LNN;
           "test_si"=NNN;
       }
       Call "capture_CK" {
           "_pi"=000N01N;
           "_po"=LN;
       }
       Call "capture_CK" {
           "_pi"=000N10N;
           "_po"=LN;
       }
   "pattern 13":
       Call "load_unload" {
           "test_so"=HNN;
           "test_si"=NN1;
       }
       Call "capture_CK" {
           "_pi"=0001NNN;
           "_po"=LH;
       }
       Call "capture_CK" {
           "_pi"=0000NNN;
           "_po"=LH;
       }
   "end 13 unload":
       Call "load_unload" {
           "test_so"=NLL;
       }
}