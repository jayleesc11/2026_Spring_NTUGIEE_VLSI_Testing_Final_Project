           V { "_si"=#; "_so"=#; "CK"=P; }
       }
   }
   "capture_CK" {
       W "_default_WFT_";
       F { "test_se"=0; }
       C { "_po"=\r151 X ; }
       "forcePI": V { "_pi"=\r80 # ; }
       "measurePO": V { "_po"=\r151 # ; }
       C { "_po"=\r151 X ; }
       "pulse": V { "CK"=P; }
