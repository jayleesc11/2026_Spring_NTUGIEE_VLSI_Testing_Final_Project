   PatList { "_pattern_" {
   }
}}
PatternExec {
   PatternBurst "_burst_";
}
Procedures {
   "load_unload" {
      W "_default_WFT_";
      C { "test_so"=X; "test_si"=0; "CK"=0; "test_se"=1; }
      Shift {          W "_default_WFT_";
         V { "_si"=#; "_so"=#; "CK"=P; }
      }
   }
   "capture_CK" {
      W "_default_WFT_";
      C { "_po"=\r107 X ; }
      "forcePI": V { "_pi"=\r31 # ; }
      "measurePO": V { "_po"=\r107 # ; }
      C { "_po"=\r107 X ; }
      "pulse": V { "CK"=P; }
   }
   "capture" {
      W "_default_WFT_";
      C { "_po"=\r107 X ; }
      "forcePI": V { "_pi"=\r31 # ; }
      "measurePO": V { "_po"=\r107 # ; }
   }
}
